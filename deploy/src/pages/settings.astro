---
import Shell from "../layouts/Shell.astro";
---
<Shell title="Settings" active="Settings">
  <div class="head">
    <div>
      <h1>Sites and ownership</h1>
      <p>A site has to prove it is ours before a single page is fetched from it. Any one of these three proofs is enough.</p>
    </div>
  </div>

  <div class="panel">
    <ol class="steps">
      <li><strong>DNS record.</strong> A TXT record at <code>_deploy-verify.&lt;hostname&gt;</code> with the proof value.</li>
      <li><strong>File.</strong> <code>/.well-known/deploy-verify.txt</code> containing the proof value.</li>
      <li><strong>Meta tag.</strong> <code>&lt;meta name="deploy-verify" content="&lt;token&gt;"&gt;</code> on the home page, where the token is the part of the proof value after the equals sign.</li>
    </ol>
  </div>

  <section aria-labelledby="h-sites">
    <h2 id="h-sites">Registered sites</h2>
    <div class="panel">
      <table class="stack">
        <thead><tr><th scope="col">Site</th><th scope="col">Ownership</th><th scope="col">Repository</th><th scope="col"><span class="sr">Actions</span></th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
    <div class="notice" id="msg" role="status"></div>
  </section>
</Shell>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var UI = window.UI, rows = document.getElementById("rows"), msg = document.getElementById("msg");
    rows.innerHTML = UI.skeleton(4);
    var how = { dns_txt: "DNS record", file: "file", meta: "meta tag" };
    var say = function (html, bad) { msg.className = bad ? "notice bad" : "notice"; msg.innerHTML = html; };
    var load = async function () {
      try {
        var d = await UI.get("/api/sites"), seed = d.storage === "seed";
        rows.innerHTML = d.sites.map(function (s) {
          var label = UI.esc(s.name);
          var own = s.verified ? '<span><span class="pill ok">Verified</span> <span class="muted">' + (how[s.verify_method] ? "by " + how[s.verify_method] + ", " : "") + UI.ago(s.verified_at) + "</span></span>" : '<span class="pill warn">Not verified</span>';
          var act = s.verified ? "" : '<button type="button" data-token="' + UI.esc(s.id) + '" aria-label="Show the proof value for ' + label + '"' + (seed ? " disabled" : "") + '>Show proof</button> <button type="button" class="primary" data-check="' + UI.esc(s.id) + '" aria-label="Check ownership of ' + label + ' now"' + (seed || !s.hostname ? " disabled" : "") + ">Check now</button>";
          return '<tr><td class="site"><b>' + label + "</b><span>" + (s.hostname ? UI.esc(s.hostname) : "No hostname yet: it cannot be verified") + '</span></td><td data-label="Ownership">' + own +
            '</td><td data-label="Repository">' + (s.github_repo ? "<code>" + UI.esc(s.github_repo) + "</code>" : '<span class="muted">Not connected</span>') + '</td><td class="act end">' + act + "</td></tr>";
        }).join("") || '<tr><td colspan="4" class="empty"><strong>No sites yet.</strong></td></tr>';
        if (seed) say("Verification is off: the database is not connected, so there are no proof values.", true);
      } catch (e) { rows.innerHTML = ""; UI.failed(msg, e); }
    };
    rows.addEventListener("click", async function (e) {
      var t = e.target.closest("button[data-token]"), c = e.target.closest("button[data-check]");
      if (t) {
        var r = await UI.get("/api/sites/" + t.dataset.token + "/token").catch(function (err) { return { error: err.message }; });
        if (!r.token) return say("Could not load the proof value. " + UI.esc(r.error || ""), true);
        say('<span class="proof"><span>Proof value for <strong>' + UI.esc(r.hostname || r.id) + '</strong>:</span><code id="proof">deploy-verify=' + UI.esc(r.token) + '</code><button type="button" data-copy>Copy</button></span>');
        return;
      }
      if (c) {
        c.disabled = true; c.setAttribute("aria-busy", "true"); c.textContent = "Checking";
        say("Checking the DNS record, the file and the meta tag.");
        var v = await UI.post("/api/sites/" + c.dataset.check + "/verify"), b = v.body;
        if (b.verified) say("Verified by " + (how[b.method] || b.method) + ". Monitoring starts on the next 5-minute run.");
        else if (b.tried) say("Not verified yet. DNS record: " + UI.esc(b.tried.dns_txt) + ". File: " + UI.esc(b.tried.file) + ". Meta tag: " + UI.esc(b.tried.meta) + ". A new DNS record can take a few minutes to appear.", true);
        else say("Could not check ownership (the server answered " + v.status + ").", true);
        await load();
      }
    });
    msg.addEventListener("click", async function (e) {
      var b = e.target.closest("button[data-copy]"); if (!b) return;
      try { await navigator.clipboard.writeText(document.getElementById("proof").textContent); b.textContent = "Copied"; }
      catch (err) { b.textContent = "Select and copy it by hand"; }
    });
    load();
  });
</script>
