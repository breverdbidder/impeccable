---
import Shell from "../layouts/Shell.astro";
---
<Shell title="Home" active="Home">
  <div class="head">
    <div>
      <h1>How our sites are doing</h1>
      <p>Uptime every 5 minutes, a crawl of every page, and a real-browser check of each home page.</p>
    </div>
    <div class="fresh" id="fresh"></div>
  </div>

  <p class="panel summary" id="summary" aria-live="polite"><span class="skel" style="width:60%"></span></p>

  <section aria-labelledby="h-sites">
    <h2 id="h-sites">Sites</h2>
    <div class="panel">
      <table class="stack">
        <thead><tr><th scope="col">Site</th><th scope="col">Status</th><th scope="col">Response</th><th scope="col">Home page paint</th><th scope="col">Open findings</th><th scope="col">Last checked</th></tr></thead>
        <tbody id="sites"></tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="h-needs">
    <h2 id="h-needs">Needs you</h2>
    <div class="panel"><ul class="feed" id="needs"></ul></div>
    <p class="notice" id="needs-status" role="status"></p>
    <p style="margin-top: var(--s3)"><a href="/monitors/">All monitors and findings</a></p>
  </section>
</Shell>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var UI = window.UI, sitesEl = document.getElementById("sites"), needs = document.getElementById("needs"), summary = document.getElementById("summary");
    sitesEl.innerHTML = UI.skeleton(6);
    var plural = function (n, one, many) { return n + " " + (n === 1 ? one : many); };
    var load = async function () {
      try {
        var r = await Promise.all([UI.get("/api/sites"), UI.get("/api/status"), UI.get("/api/findings"), UI.get("/api/page-checks")]);
        var sites = r[0].sites, status = {}, checks = {}, open = {}, names = {};
        r[1].sites.forEach(function (s) { status[s.site_id] = s; });
        r[3].checks.forEach(function (c) { checks[c.site_id] = c; });
        r[2].findings.forEach(function (f) { open[f.site_id] = (open[f.site_id] || 0) + 1; });
        sites.forEach(function (s) { names[s.id] = s.name; });

        var verified = sites.filter(function (s) { return s.verified; }), down = verified.filter(function (s) { return status[s.id] && !status[s.id].ok; });
        var waiting = sites.length - verified.length, n = r[2].findings.length;
        summary.innerHTML = !sites.length ? "No sites are registered yet."
          : !verified.length ? "No site is being watched yet. <a href=\"/settings/\">Verify a site</a> to start."
          : (down.length ? "<strong>" + plural(down.length, "site is", "sites are") + " down:</strong> " + down.map(function (s) { return UI.esc(s.name); }).join(", ") + ". "
              : "<strong>" + (verified.length === 1 ? "The monitored site is up." : "All " + verified.length + " monitored sites are up.") + "</strong> ")
            + (n ? plural(n, "finding needs", "findings need") + " a look." : "Nothing needs you.")
            + (waiting ? " " + plural(waiting, "site is", "sites are") + " waiting to be <a href=\"/settings/\">verified</a>." : "");

        sitesEl.innerHTML = sites.map(function (s) {
          var st = status[s.id], c = checks[s.id], host = s.hostname ? UI.esc(s.hostname) : "No hostname yet";
          var name = '<td class="site"><b>' + UI.esc(s.name) + "</b><span>" + host + "</span></td>";
          if (!s.verified) return "<tr>" + name + '<td data-label="Status"><span class="pill warn">Not verified</span></td><td colspan="4" class="muted">Nothing is fetched until this site proves it is ours. <a href="/settings/">Verify it</a></td></tr>';
          var state = !st ? '<span class="pill">Waiting for first check</span>' : st.ok ? '<span class="pill ok">Up</span>' : '<span class="pill bad">Down</span>';
          var resp = !st ? "" : st.ok ? '<span class="num">' + st.ms + " ms</span>" : "<span>Answered " + (st.status || "nothing") + (st.down_since ? ", since " + UI.ago(st.down_since) : "") + "</span>";
          var paint = !c || c.lcp_ms == null ? '<span class="muted">Not measured yet</span>' : '<span class="pill ' + (c.lcp_ms <= 2500 ? "ok" : c.lcp_ms <= 4000 ? "warn" : "bad") + '">' + (c.lcp_ms / 1000).toFixed(1) + " s</span>";
          var k = open[s.id] || 0;
          return "<tr>" + name + '<td data-label="Status">' + state + '</td><td data-label="Response">' + resp + '</td><td data-label="Home page paint">' + paint +
            '</td><td data-label="Open findings" class="num">' + (k ? '<a href="/monitors/#findings">' + k + "</a>" : "0") + '</td><td data-label="Last checked" class="muted">' + (st ? UI.ago(st.ran_at) : "") + "</td></tr>";
        }).join("") || '<tr><td colspan="6" class="empty"><strong>No sites yet.</strong>Sites are added to the registry in the database, then verified in Settings.</td></tr>';

        UI.findings(needs, r[2].findings, names, 6);
      } catch (e) { sitesEl.innerHTML = ""; needs.innerHTML = ""; UI.failed(summary, e); }
    };
    var refresh = UI.freshness(document.getElementById("fresh"), load);
    UI.wireFindings(needs, document.getElementById("needs-status"), refresh);
  });
</script>
