---
import Shell from "../layouts/Shell.astro";
---
<Shell title="Monitors" active="Monitors">
  <div class="head">
    <div>
      <h1>Monitors</h1>
      <p>What each check has seen. Only pages on a site's own hostname are ever fetched.</p>
    </div>
    <div class="fresh" id="fresh"></div>
  </div>
  <div id="error"></div>

  <section aria-labelledby="h-findings" id="findings">
    <h2 id="h-findings">Open findings</h2>
    <div class="panel"><ul class="feed" id="list"></ul></div>
    <p class="notice" id="list-status" role="status"></p>
  </section>

  <section aria-labelledby="h-checks">
    <h2 id="h-checks">Page checks</h2>
    <p>A real browser loads each home page when the site is first verified, when its content changes (a new deploy) and once a day. These are lab numbers from one load, not Lighthouse scores.</p>
    <div class="panel">
      <table class="stack">
        <thead><tr><th scope="col">Site</th><th scope="col">Largest paint</th><th scope="col">Layout shift</th><th scope="col">Page weight</th><th scope="col">Console errors</th><th scope="col">Visual change</th><th scope="col">Checked</th><th scope="col">Screenshot</th></tr></thead>
        <tbody id="checks"></tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="h-crawl">
    <h2 id="h-crawl">Crawl coverage</h2>
    <p>One site per 5-minute run: robots.txt and the sitemap once a day, then the pages that have waited longest.</p>
    <div class="panel">
      <table class="stack">
        <thead><tr><th scope="col">Site</th><th scope="col">Sitemap</th><th scope="col">Pages known</th><th scope="col">Crawled</th><th scope="col">Broken</th><th scope="col">Last run</th></tr></thead>
        <tbody id="crawl"></tbody>
      </table>
    </div>
  </section>
</Shell>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var UI = window.UI, crawl = document.getElementById("crawl"), checks = document.getElementById("checks"), list = document.getElementById("list"), error = document.getElementById("error");
    crawl.innerHTML = UI.skeleton(6); checks.innerHTML = UI.skeleton(8);
    var grade = function (v, ok, poor, fmt) { return v == null ? '<span class="muted">Not measured</span>' : '<span class="pill ' + (v <= ok ? "ok" : v <= poor ? "warn" : "bad") + '">' + fmt(v) + "</span>"; };
    var load = async function () {
      try {
        var r = await Promise.all([UI.get("/api/sites"), UI.get("/api/crawl"), UI.get("/api/page-checks"), UI.get("/api/findings")]);
        var names = {}, hosts = {}, verified = {};
        r[0].sites.forEach(function (s) { names[s.id] = s.name; hosts[s.id] = s.hostname; verified[s.id] = s.verified; });
        var site = function (id) { return '<td class="site"><b>' + UI.esc(names[id] || id) + "</b><span>" + UI.esc(hosts[id] || "") + "</span></td>"; };
        error.innerHTML = "";

        UI.findings(list, r[3].findings, names);

        checks.innerHTML = r[2].checks.map(function (x) {
          if (x.error) return "<tr>" + site(x.site_id) + '<td colspan="6"><span class="pill bad">Check failed</span> ' + UI.esc(x.error) + '</td><td data-label="Checked" class="muted">' + UI.ago(x.ran_at) + "</td></tr>";
          var shot = x.shot_key ? '<a class="thumb" href="/api/shots/' + UI.esc(x.shot_key) + '" target="_blank" rel="noopener"><img src="/api/shots/' + UI.esc(x.shot_key) + '" alt="Screenshot of ' + UI.esc(names[x.site_id] || x.site_id) + ' home page, opens full size in a new tab" loading="lazy" width="72" height="54"></a>' : "";
          return "<tr>" + site(x.site_id) +
            '<td data-label="Largest paint">' + grade(x.lcp_ms, 2500, 4000, function (n) { return (n / 1000).toFixed(1) + " s"; }) + "</td>" +
            '<td data-label="Layout shift">' + grade(x.cls, 0.1, 0.25, function (n) { return n.toFixed(2); }) + "</td>" +
            '<td data-label="Page weight" class="num">' + (x.transfer_bytes == null ? "" : "<span>" + (x.transfer_bytes / 1048576).toFixed(1) + " MB" + (x.requests ? ' <span class="muted">in ' + x.requests + " requests</span>" : "") + "</span>") + "</td>" +
            '<td data-label="Console errors">' + (x.console_errors ? '<span class="pill warn">' + x.console_errors + "</span>" : '<span class="num">0</span>') + "</td>" +
            '<td data-label="Visual change">' + (x.diff_pct == null ? '<span class="muted">First check</span>' : grade(x.diff_pct, 1, 5, function (n) { return n.toFixed(1) + "%"; })) + "</td>" +
            '<td data-label="Checked" class="muted">' + UI.ago(x.ran_at) + '</td><td data-label="Screenshot">' + shot + "</td></tr>";
        }).join("") || '<tr><td colspan="8" class="empty"><strong>No page checks yet.</strong>The first one runs within a few minutes of a site being verified.</td></tr>';

        crawl.innerHTML = r[1].sites.map(function (s) {
          if (!verified[s.site_id]) return "<tr>" + site(s.site_id) + '<td colspan="5" class="muted">Not crawled: this site is not verified. <a href="/settings/">Verify it</a></td></tr>';
          var map = s.sitemap_url ? (s.sitemap_count || 0) + (s.sitemap_count === 1 ? " URL" : " URLs") : s.last_tick ? '<span class="pill warn">Not found</span>' : '<span class="muted">Not read yet</span>';
          var pct = s.pages ? Math.round((s.crawled / s.pages) * 100) : 0;
          return "<tr>" + site(s.site_id) + '<td data-label="Sitemap" class="num">' + map + '</td><td data-label="Pages known" class="num">' + s.pages +
            '</td><td data-label="Crawled" class="num">' + "<span>" + s.crawled + (s.pages ? ' <span class="muted">(' + pct + "%)</span>" : "") + "</span>" +
            '</td><td data-label="Broken">' + (s.broken ? '<span class="pill bad">' + s.broken + "</span>" : '<span class="num">0</span>') +
            '</td><td data-label="Last run" class="muted">' + (s.last_tick ? UI.ago(s.last_tick) : "Waiting for its first run") + "</td></tr>";
        }).join("") || '<tr><td colspan="6" class="empty"><strong>No sites yet.</strong></td></tr>';
      } catch (e) { crawl.innerHTML = ""; checks.innerHTML = ""; list.innerHTML = ""; UI.failed(error, e); }
    };
    var refresh = UI.freshness(document.getElementById("fresh"), load);
    UI.wireFindings(list, document.getElementById("list-status"), refresh);
  });
</script>
