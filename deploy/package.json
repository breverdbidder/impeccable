{
  "name": "deploy-internal",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "astro build && wrangler deploy",
    "dev:worker": "astro build && wrangler dev",
    "bundle": "astro build && esbuild src/worker-inline.ts --bundle --format=esm --minify --charset=ascii --loader:.html=text --loader:.json=json --target=es2022 --outfile=build/worker.js"
  },
  "dependencies": {
    "astro": "^7.4.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4",
    "esbuild": "*"
  }
}
