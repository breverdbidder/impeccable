{
  // Deploy, internal. One Worker with static assets, D1 and a cron trigger.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deploy-internal",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "404-page" },
  "d1_databases": [
    { "binding": "DB", "database_name": "deploy-internal", "database_id": "d913e974-a802-45a6-93cf-60eb76c21716", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
  // Set as variables in the dashboard or with `wrangler secret put`:
  //   ACCESS_TEAM_DOMAIN  <team>.cloudflareaccess.com
  //   ACCESS_AUD          the Access application's AUD tag
}
