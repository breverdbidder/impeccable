{
  // Deploy, internal. One Worker with static assets, D1 and a cron trigger.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deploy-internal",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "404-page" },
  "d1_databases": [
    { "binding": "DB", "database_name": "deploy-internal", "database_id": "d913e974-a802-45a6-93cf-60eb76c21716", "migrations_dir": "migrations" }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "deploy-internal-shots" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  // Cloudflare Access application "Deploy (internal)" guards the workers.dev hostname.
  // Neither value is a secret: the AUD tag only identifies the application.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "falling-tooth-4abb.cloudflareaccess.com",
    "ACCESS_AUD": "1f1b756b8055fe2a5d8dd83662ae0e96b678c8e232f2e9254480fb30493b1fc3"
  }
}
